# ── AI Provider ──────────────────────────────────────────────────────────────
# Switch between "gemini" (free tier) and "claude" (higher reliability).
# Only the key for the selected provider is required.
NEXT_PUBLIC_AI_PROVIDER=gemini

# Gemini (used when provider=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Claude (used when provider=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-sonnet-4-6

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GSTGenius

# ── Supabase ──────────────────────────────────────────────────────────────────
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Razorpay (add when you set it up) ─────────────────────────────────────────
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
